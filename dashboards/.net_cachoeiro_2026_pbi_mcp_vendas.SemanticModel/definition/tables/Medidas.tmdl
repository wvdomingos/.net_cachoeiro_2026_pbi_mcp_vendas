table Medidas
	lineageTag: bc5a0d18-53a9-42ca-ba07-59354dc4292e

	/// Texto 'Atualização: <data e hora>' da última atualização do modelo, em horário de Brasília (tabela Atualizacao).
	measure txtAtualizacao = "Atualização: " & MAX(Atualizacao[Data e Hora])
		displayFolder: 0. Aux
		lineageTag: 97da66ff-53c2-478e-91bb-da888222b682

	/// Medida auxiliar constante (0). Usada para forçar contexto em visuais sem métrica de negócio.
	measure Dummy = {0}
		formatString: 0
		displayFolder: 0. Aux
		lineageTag: 3581f06a-c2d1-44f6-bab6-7702f11c7db4

	/// Receita líquida dos pedidos faturados: Quantidade × PreçoUnitário × (1 − DescontoPct). Exclui pedidos cancelados.
	measure Receita =
			CALCULATE(
			    SUMX(
			        fato_vendas,
			        fato_vendas[Quantidade] * fato_vendas[PrecoUnitario] * ( 1 - fato_vendas[DescontoPct] )
			    ),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 11b925eb-c892-4e60-9f0e-1d994e950057

	/// Receita antes do desconto dos pedidos faturados: Quantidade × PreçoUnitário.
	measure 'Receita Bruta' =
			CALCULATE(
			    SUMX( fato_vendas, fato_vendas[Quantidade] * fato_vendas[PrecoUnitario] ),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: e03a3134-5bd7-4ac0-89f8-b871610ee3d0

	/// Valor total concedido em desconto nos pedidos faturados: Receita Bruta − Receita.
	measure Desconto = [Receita Bruta] - [Receita]
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 760fb03b-b7d8-46d3-8140-cb607d086c16

	/// Desconto médio ponderado sobre a receita bruta: Desconto ÷ Receita Bruta.
	measure 'Desconto %' = DIVIDE( [Desconto], [Receita Bruta] )
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 8ecbcd2d-ed41-489d-95a7-c8d2c5653c6a

	/// Custo total dos pedidos faturados: Quantidade × CustoUnitário.
	measure Custo =
			CALCULATE(
			    SUMX( fato_vendas, fato_vendas[Quantidade] * fato_vendas[CustoUnitario] ),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 788baf39-4a31-4cc8-992d-91d60dadbedb

	/// Margem bruta em valor: Receita − Custo.
	measure 'Margem Bruta' = [Receita] - [Custo]
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: ca79f5f3-56df-4eff-aa36-ac495ee2f488

	/// Margem bruta percentual sobre a receita líquida: Margem Bruta ÷ Receita.
	measure 'Margem Bruta %' = DIVIDE( [Margem Bruta], [Receita] )
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 534158e4-31d9-4fac-b1d5-9765c3cbb683

	/// Soma das quantidades dos pedidos faturados.
	measure 'Quantidade Vendida' = CALCULATE( SUM( fato_vendas[Quantidade] ), fato_vendas[Status] = "Faturado" )
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: 444a3389-fc33-4a77-a8c6-f6dad5b7090d

	/// Quantidade de pedidos faturados (contagem distinta de PedidoID).
	measure Pedidos = CALCULATE( DISTINCTCOUNT( fato_vendas[PedidoID] ), fato_vendas[Status] = "Faturado" )
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: 16943e0e-0043-41e4-a2c0-55730439b29d

	/// Quantidade de pedidos com Status = Cancelado.
	measure 'Pedidos Cancelados' = CALCULATE( DISTINCTCOUNT( fato_vendas[PedidoID] ), fato_vendas[Status] = "Cancelado" )
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: c0de36d9-b890-4bb1-9977-7c6f38b7bbab

	/// Pedidos cancelados sobre o total de pedidos (faturados + cancelados).
	measure 'Taxa de Cancelamento %' = DIVIDE( [Pedidos Cancelados], [Pedidos] + [Pedidos Cancelados] )
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 8a58eea1-d5a8-4504-aef1-93dab4a2e1dd

	/// Receita média por pedido faturado: Receita ÷ Pedidos.
	measure 'Ticket Médio' = DIVIDE( [Receita], [Pedidos] )
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 22bd9595-0a48-41d5-9fc6-68a4e0b131bc

	/// Clientes distintos com ao menos um pedido faturado no período filtrado.
	measure 'Clientes Ativos' = CALCULATE( DISTINCTCOUNT( fato_vendas[ClienteID] ), fato_vendas[Status] = "Faturado" )
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: dbeb0512-e110-4a52-9392-c360a6d09c0b

	/// Meta de faturamento (soma de metas_mensais[MetaValor]). Grão mensal: válida em mês, trimestre, ano; vazia em filtro de dia que não inclua o dia 1.
	measure Meta = SUM( metas_mensais[MetaValor] )
		formatString: "R$" #,##0.00
		displayFolder: 2. Meta
		lineageTag: 28dd4b53-f7d4-4dd7-9cab-ee0d84d6adf4

	/// Percentual da meta atingido: Receita ÷ Meta. Em branco quando não há meta no contexto.
	measure 'Atingimento %' = DIVIDE( [Receita], [Meta] )
		formatString: 0.0%
		displayFolder: 2. Meta
		lineageTag: 02217724-8036-4e1b-a06e-dad11c0beada

	/// Diferença entre receita e meta: Receita − Meta. Negativo = abaixo da meta. Em branco quando falta meta ou receita no contexto (ex.: mês futuro).
	measure 'Gap Meta' = IF( ISBLANK( [Meta] ) || ISBLANK( [Receita] ), BLANK(), [Receita] - [Meta] )
		formatString: "R$" #,##0.00;-"R$" #,##0.00
		displayFolder: 2. Meta
		lineageTag: 7c2b3c61-d171-4d80-8b15-01b3f49621a2

	/// Receita no mesmo período do ano anterior (SAMEPERIODLASTYEAR sobre dim_calendario[Data]).
	measure 'Receita Ano Anterior' = CALCULATE( [Receita], SAMEPERIODLASTYEAR( dim_calendario[Data] ) )
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 74a497ca-00ac-4ff1-89c4-b26fa573a14a

	/// Variação da receita contra o mesmo período do ano anterior: (Receita − Receita Ano Anterior) ÷ Receita Ano Anterior.
	measure 'Receita Var. Anual %' =
			VAR _atual = [Receita]
			VAR _anterior = [Receita Ano Anterior]
			RETURN
			    IF( ISBLANK( _atual ) || ISBLANK( _anterior ), BLANK(), DIVIDE( _atual - _anterior, _anterior ) )
		formatString: 0.0%;-0.0%
		displayFolder: 3. Tempo
		lineageTag: 5ec6be8a-3b54-43bd-badc-280286aecc2e

	/// Receita do período equivalente deslocado um mês para trás (DATEADD −1 mês sobre dim_calendario[Data]).
	measure 'Receita Mês Anterior' = CALCULATE( [Receita], DATEADD( dim_calendario[Data], -1, MONTH ) )
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 28b382c8-0b25-4306-8ef1-bc7fa014a7ed

	/// Variação da receita contra o mês anterior: (Receita − Receita Mês Anterior) ÷ Receita Mês Anterior.
	measure 'Receita Var. Mensal %' =
			VAR _atual = [Receita]
			VAR _anterior = [Receita Mês Anterior]
			RETURN
			    IF( ISBLANK( _atual ) || ISBLANK( _anterior ), BLANK(), DIVIDE( _atual - _anterior, _anterior ) )
		formatString: 0.0%;-0.0%
		displayFolder: 3. Tempo
		lineageTag: 5e95d847-2bae-42bf-9a73-4546acd0a692

	/// Receita acumulada no ano até a data filtrada (TOTALYTD sobre dim_calendario[Data]).
	measure 'Receita Acumulada Ano' = TOTALYTD( [Receita], dim_calendario[Data] )
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: ccac5edd-9664-42b1-b4e8-a081c9c894ea

	/// Meta acumulada no ano até o mês filtrado (TOTALYTD sobre dim_calendario[Data]).
	measure 'Meta Acumulada Ano' = TOTALYTD( [Meta], dim_calendario[Data] )
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 5b7b9fb5-e99c-4b59-a2f8-98c1ceb61270

	/// Atingimento da meta no acumulado do ano: Receita Acumulada Ano ÷ Meta Acumulada Ano.
	measure 'Atingimento Acumulado Ano %' = DIVIDE( [Receita Acumulada Ano], [Meta Acumulada Ano] )
		formatString: 0.0%
		displayFolder: 3. Tempo
		lineageTag: 52ba412e-1df6-4b67-9073-3acfdf88c61d

	/// HTML com 4 cards KPI em uma linha (Receita, Atingimento da Meta, Pedidos, Ticket Médio) para o visual HTML Content. Segue DESING.md: tokens de cor fixos, Segoe UI, card = título → valor → comparação → estado; período declarado uma vez abaixo da linha. Comparação = mesmo período do ano anterior (meta no card de atingimento). Favorável = variação ≥ 0 / meta ≥ 100%; 'não definido' quando falta base.
	measure 'HTML KPIs Visão Geral' =
			-- Tokens (DESING.md)
			VAR _cCard = "#11162D"
			VAR _cText = "#F5F7FF"
			VAR _cSec  = "#BFC8E2"
			VAR _cFav  = "#50D6B2"
			VAR _cDes  = "#FF7D92"
			
			-- Período com vendas no contexto
			VAR _d1 = CALCULATE( MIN( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _d2 = CALCULATE( MAX( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _periodo =
			    IF( ISBLANK( _d1 ), "Sem dados para os filtros atuais",
			        "Período: " & FORMAT( _d1, "dd/MM/yyyy" ) & " a " & FORMAT( _d2, "dd/MM/yyyy" ) & " · comparação com o mesmo período do ano anterior" )
			
			-- Valores
			VAR _rec    = [Receita]
			VAR _varRec = [Receita Var. Anual %]
			VAR _meta   = [Meta]
			VAR _ating  = [Atingimento %]
			VAR _gap    = [Gap Meta]
			VAR _ped    = [Pedidos]
			VAR _pedAA  = CALCULATE( [Pedidos], SAMEPERIODLASTYEAR( dim_calendario[Data] ) )
			VAR _varPed = IF( ISBLANK( _ped ) || ISBLANK( _pedAA ), BLANK(), DIVIDE( _ped - _pedAA, _pedAA ) )
			VAR _tk     = [Ticket Médio]
			VAR _tkAA   = CALCULATE( [Ticket Médio], SAMEPERIODLASTYEAR( dim_calendario[Data] ) )
			VAR _varTk  = IF( ISBLANK( _tk ) || ISBLANK( _tkAA ), BLANK(), DIVIDE( _tk - _tkAA, _tkAA ) )
			
			-- Template: {T} título, {V} valor, {C} comparação, {SC} cor do estado, {S} estado
			VAR _tpl =
			    "<div style='background:" & _cCard & ";border-radius:8px;padding:24px;display:flex;flex-direction:column;gap:8px;min-width:0;'>" &
			    "<div style='color:" & _cText & ";font-size:16pt;font-weight:600;'>{T}</div>" &
			    "<div style='color:" & _cText & ";font-size:32pt;font-weight:600;line-height:1.1;white-space:nowrap;'>{V}</div>" &
			    "<div style='color:" & _cSec & ";font-size:14pt;'>{C}</div>" &
			    "<div style='color:{SC};font-size:12pt;font-weight:600;'>{S}</div>" &
			    "</div>"
			
			VAR _semDados = "—"
			VAR _naoDef   = "Comparação não definida"
			VAR _pct      = "+0.0%;-0.0%;0.0%"
			
			-- 1. Receita
			VAR _c1 = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( _tpl,
			    "{T}", "Receita líquida" ),
			    "{V}", IF( ISBLANK( _rec ), _semDados, FORMAT( _rec, "R$ #,##0", "pt-BR" ) ) ),
			    "{C}", IF( ISBLANK( _varRec ), _naoDef, FORMAT( _varRec, _pct, "pt-BR" ) & " vs. ano anterior" ) ),
			    "{SC}", SWITCH( TRUE(), ISBLANK( _varRec ), _cSec, _varRec >= 0, _cFav, _cDes ) ),
			    "{S}", SWITCH( TRUE(), ISBLANK( _varRec ), "Estado não definido", _varRec >= 0, "✔ Favorável", "✖ Desfavorável" ) )
			
			-- 2. Atingimento da meta
			VAR _c2 = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( _tpl,
			    "{T}", "Atingimento da meta" ),
			    "{V}", IF( ISBLANK( _ating ), _semDados, FORMAT( _ating, "0.0%", "pt-BR" ) ) ),
			    "{C}", IF( ISBLANK( _meta ), "Meta não definida no período", "Gap " & FORMAT( _gap, "+R$ #,##0;-R$ #,##0;R$ 0", "pt-BR" ) & " sobre meta de " & FORMAT( _meta, "R$ #,##0", "pt-BR" ) ) ),
			    "{SC}", SWITCH( TRUE(), ISBLANK( _ating ), _cSec, _ating >= 1, _cFav, _cDes ) ),
			    "{S}", SWITCH( TRUE(), ISBLANK( _ating ), "Estado não definido", _ating >= 1, "✔ Favorável", "✖ Desfavorável" ) )
			
			-- 3. Pedidos
			VAR _c3 = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( _tpl,
			    "{T}", "Pedidos faturados" ),
			    "{V}", IF( ISBLANK( _ped ), _semDados, FORMAT( _ped, "#,##0", "pt-BR" ) ) ),
			    "{C}", IF( ISBLANK( _varPed ), _naoDef, FORMAT( _varPed, _pct, "pt-BR" ) & " vs. ano anterior" ) ),
			    "{SC}", SWITCH( TRUE(), ISBLANK( _varPed ), _cSec, _varPed >= 0, _cFav, _cDes ) ),
			    "{S}", SWITCH( TRUE(), ISBLANK( _varPed ), "Estado não definido", _varPed >= 0, "✔ Favorável", "✖ Desfavorável" ) )
			
			-- 4. Ticket médio
			VAR _c4 = SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( _tpl,
			    "{T}", "Ticket médio" ),
			    "{V}", IF( ISBLANK( _tk ), _semDados, FORMAT( _tk, "R$ #,##0", "pt-BR" ) ) ),
			    "{C}", IF( ISBLANK( _varTk ), _naoDef, FORMAT( _varTk, _pct, "pt-BR" ) & " vs. ano anterior" ) ),
			    "{SC}", SWITCH( TRUE(), ISBLANK( _varTk ), _cSec, _varTk >= 0, _cFav, _cDes ) ),
			    "{S}", SWITCH( TRUE(), ISBLANK( _varTk ), "Estado não definido", _varTk >= 0, "✔ Favorável", "✖ Desfavorável" ) )
			
			RETURN
			    "<div style='font-family:Segoe UI,Segoe,sans-serif;'>" &
			    "<div style='display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;'>" &
			    _c1 & _c2 & _c3 & _c4 &
			    "</div>" &
			    "<div style='color:" & _cSec & ";font-size:12pt;margin-top:12px;'>" & _periodo & "</div>" &
			    "</div>"
		displayFolder: 4. HTML
		lineageTag: 4ba30736-a3ec-42a0-b0f5-734b425b20a8

	/// Texto narrativo em HTML para a diretoria (visual HTML Content), gerado dos dados do contexto: insight principal (receita, meta, variação anual), contexto (região, vendedor, categoria e canal líderes; margem; cancelamento), pontos de atenção (vendedor com menor atingimento, região com maior queda anual) e próximos passos derivados só dos números. Segue DESING.md: insight → contexto → ação, tokens de cor fixos, sem dados inventados. Frases somem quando falta base.
	measure 'HTML Narrativa Visão Geral' =
			-- Tokens (DESING.md)
			VAR _cCard = "#11162D"
			VAR _cText = "#F5F7FF"
			VAR _cSec  = "#BFC8E2"
			VAR _cRef  = "#3CCBFF"
			VAR _cFav  = "#50D6B2"
			VAR _cAtn  = "#FFC66D"
			VAR _cDes  = "#FF7D92"
			
			-- Formatos
			VAR _fBRL = "R$ #,##0"
			VAR _fPct = "0.0%"
			VAR _fVar = "+0.0%;-0.0%;0.0%"
			
			-- KPIs do contexto
			VAR _rec     = [Receita]
			VAR _varRec  = [Receita Var. Anual %]
			VAR _meta    = [Meta]
			VAR _ating   = [Atingimento %]
			VAR _gap     = [Gap Meta]
			VAR _ped     = [Pedidos]
			VAR _tk      = [Ticket Médio]
			VAR _mg      = [Margem Bruta %]
			VAR _canc    = [Taxa de Cancelamento %]
			VAR _cli     = [Clientes Ativos]
			VAR _d1 = CALCULATE( MIN( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _d2 = CALCULATE( MAX( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _periodo = FORMAT( _d1, "dd/MM/yyyy" ) & " a " & FORMAT( _d2, "dd/MM/yyyy" )
			
			-- Rankings no contexto atual
			VAR _tReg = ADDCOLUMNS( VALUES( dim_clientes[Regiao] ), "@r", [Receita], "@v", [Receita Var. Anual %] )
			VAR _regTopRow = TOPN( 1, FILTER( _tReg, NOT ISBLANK( [@r] ) ), [@r], DESC )
			VAR _regTop    = MAXX( _regTopRow, dim_clientes[Regiao] )
			VAR _regTopRec = MAXX( _regTopRow, [@r] )
			VAR _regTopPct = DIVIDE( _regTopRec, _rec )
			VAR _regPiorRow = TOPN( 1, FILTER( _tReg, NOT ISBLANK( [@v] ) ), [@v], ASC )
			VAR _regPior    = MAXX( _regPiorRow, dim_clientes[Regiao] )
			VAR _regPiorVar = MAXX( _regPiorRow, [@v] )
			
			VAR _tVend = ADDCOLUMNS( VALUES( dim_vendedores[Vendedor] ), "@r", [Receita], "@a", [Atingimento %] )
			VAR _vendTopRow = TOPN( 1, FILTER( _tVend, NOT ISBLANK( [@r] ) ), [@r], DESC )
			VAR _vendTop    = MAXX( _vendTopRow, dim_vendedores[Vendedor] )
			VAR _vendTopRec = MAXX( _vendTopRow, [@r] )
			VAR _vendTopAt  = MAXX( _vendTopRow, [@a] )
			VAR _vendPiorRow = TOPN( 1, FILTER( _tVend, NOT ISBLANK( [@a] ) ), [@a], ASC )
			VAR _vendPior    = MAXX( _vendPiorRow, dim_vendedores[Vendedor] )
			VAR _vendPiorAt  = MAXX( _vendPiorRow, [@a] )
			VAR _vendAbaixo  = COUNTROWS( FILTER( _tVend, NOT ISBLANK( [@a] ) && [@a] < 1 ) )
			VAR _vendComMeta = COUNTROWS( FILTER( _tVend, NOT ISBLANK( [@a] ) ) )
			
			VAR _tCat = ADDCOLUMNS( VALUES( dim_produtos[Categoria] ), "@r", [Receita] )
			VAR _catTopRow = TOPN( 1, FILTER( _tCat, NOT ISBLANK( [@r] ) ), [@r], DESC )
			VAR _catTop    = MAXX( _catTopRow, dim_produtos[Categoria] )
			VAR _catTopPct = DIVIDE( MAXX( _catTopRow, [@r] ), _rec )
			
			VAR _tCanal = ADDCOLUMNS( VALUES( fato_vendas[Canal] ), "@r", [Receita] )
			VAR _canalTopRow = TOPN( 1, FILTER( _tCanal, NOT ISBLANK( [@r] ) ), [@r], DESC )
			VAR _canalTop    = MAXX( _canalTopRow, fato_vendas[Canal] )
			VAR _canalTopPct = DIVIDE( MAXX( _canalTopRow, [@r] ), _rec )
			
			-- Helpers de HTML
			VAR _b1 = "<strong style='color:" & _cText & ";'>"
			VAR _b0 = "</strong>"
			VAR _pOpen  = "<p style='margin:0 0 12px 0;'>"
			VAR _pClose = "</p>"
			VAR _h = "<div style='color:" & _cRef & ";font-size:12pt;font-weight:600;letter-spacing:.04em;margin:16px 0 8px 0;'>"
			
			-- 1. Insight principal
			VAR _corAting = SWITCH( TRUE(), ISBLANK( _ating ), _cSec, _ating >= 1, _cFav, _cDes )
			VAR _fraseMeta =
			    IF( ISBLANK( _meta ), "sem meta definida para o período",
			        "<span style='color:" & _corAting & ";font-weight:600;'>" & FORMAT( _ating, _fPct, "pt-BR" ) & " da meta</span> de " & FORMAT( _meta, _fBRL, "pt-BR" ) &
			        " (" & IF( _gap >= 0, "folga", "gap" ) & " de " & FORMAT( ABS( _gap ), _fBRL, "pt-BR" ) & ")" )
			VAR _fraseVar =
			    IF( ISBLANK( _varRec ), "",
			        " e <span style='color:" & IF( _varRec >= 0, _cFav, _cDes ) & ";font-weight:600;'>" & FORMAT( _varRec, _fVar, "pt-BR" ) & "</span> frente ao mesmo período do ano anterior" )
			VAR _insight =
			    "<div style='color:" & _cText & ";font-size:20pt;font-weight:600;line-height:1.3;'>" &
			    "Receita de " & FORMAT( _rec, _fBRL, "pt-BR" ) & ", " & _fraseMeta & _fraseVar & "." &
			    "</div>"
			
			-- 2. Contexto
			VAR _ctx1 =
			    IF( ISBLANK( _regTop ), "",
			        _pOpen & "A região " & _b1 & _regTop & _b0 & " lidera com " & FORMAT( _regTopRec, _fBRL, "pt-BR" ) & " (" & FORMAT( _regTopPct, _fPct, "pt-BR" ) & " do total)" &
			        IF( ISBLANK( _catTop ), "", "; a categoria " & _b1 & _catTop & _b0 & " responde por " & FORMAT( _catTopPct, _fPct, "pt-BR" ) ) &
			        IF( ISBLANK( _canalTop ), "", " e o canal " & _b1 & _canalTop & _b0 & " por " & FORMAT( _canalTopPct, _fPct, "pt-BR" ) ) & "." & _pClose )
			VAR _ctx2 =
			    IF( ISBLANK( _vendTop ), "",
			        _pOpen & "Maior receita individual: " & _b1 & _vendTop & _b0 & " com " & FORMAT( _vendTopRec, _fBRL, "pt-BR" ) &
			        IF( ISBLANK( _vendTopAt ), "", " (" & FORMAT( _vendTopAt, _fPct, "pt-BR" ) & " da meta)" ) &
			        IF( ISBLANK( _vendComMeta ) || _vendComMeta = 0, "", "; " & _vendAbaixo & " de " & _vendComMeta & " vendedores estão abaixo da meta" ) & "." & _pClose )
			VAR _ctx3 =
			    _pOpen & FORMAT( _ped, "#,##0", "pt-BR" ) & " pedidos faturados para " & FORMAT( _cli, "#,##0", "pt-BR" ) & " clientes, ticket médio de " & _b1 & FORMAT( _tk, _fBRL, "pt-BR" ) & _b0 &
			    ", margem bruta de " & _b1 & FORMAT( _mg, _fPct, "pt-BR" ) & _b0 & " e cancelamento de " & FORMAT( _canc, _fPct, "pt-BR" ) & " dos pedidos." & _pClose
			
			-- 3. Pontos de atenção (só quando há base)
			VAR _at1 =
			    IF( ISBLANK( _vendPior ) || _vendPiorAt >= 1, "",
			        "<li>Menor atingimento: " & _b1 & _vendPior & _b0 & " com " & FORMAT( _vendPiorAt, _fPct, "pt-BR" ) & " da meta.</li>" )
			VAR _at2 =
			    IF( ISBLANK( _regPior ) || _regPiorVar >= 0, "",
			        "<li>Maior queda anual: região " & _b1 & _regPior & _b0 & " com " & FORMAT( _regPiorVar, _fVar, "pt-BR" ) & " frente ao ano anterior.</li>" )
			VAR _at3 =
			    IF( ISBLANK( _canc ), "",
			        "<li>Cancelamentos: " & FORMAT( [Pedidos Cancelados], "#,##0", "pt-BR" ) & " pedidos (" & FORMAT( _canc, _fPct, "pt-BR" ) & "), equivalentes a " &
			        FORMAT( CALCULATE( SUMX( fato_vendas, fato_vendas[Quantidade] * fato_vendas[PrecoUnitario] * ( 1 - fato_vendas[DescontoPct] ) ), fato_vendas[Status] = "Cancelado" ), _fBRL, "pt-BR" ) & " não faturados.</li>" )
			VAR _atencao =
			    IF( _at1 = "" && _at2 = "" && _at3 = "", "",
			        _h & "PONTOS DE ATENÇÃO</div><ul style='margin:0;padding-left:20px;'>" & _at1 & _at2 & _at3 & "</ul>" )
			
			-- 4. Próximos passos (derivados dos números; responsável não definido)
			VAR _ps1 = IF( ISBLANK( _ating ) || _ating >= 1, "", "<li>Fechar o gap de " & FORMAT( ABS( _gap ), _fBRL, "pt-BR" ) & " para a meta do período.</li>" )
			VAR _ps2 = IF( ISBLANK( _vendPior ) || _vendPiorAt >= 1, "", "<li>Revisar o plano de " & _vendPior & " e dos demais vendedores abaixo da meta.</li>" )
			VAR _ps3 = IF( ISBLANK( _regPior ) || _regPiorVar >= 0, "", "<li>Investigar a causa da queda na região " & _regPior & ".</li>" )
			VAR _passos =
			    IF( _ps1 = "" && _ps2 = "" && _ps3 = "", "",
			        _h & "PRÓXIMOS PASSOS</div><ul style='margin:0;padding-left:20px;'>" & _ps1 & _ps2 & _ps3 & "</ul>" &
			        "<div style='color:" & _cSec & ";font-size:12pt;margin-top:8px;'>Responsável e prazo: não definidos.</div>" )
			
			RETURN
			    IF( ISBLANK( _rec ),
			        "<div style='font-family:Segoe UI,Segoe,sans-serif;background:" & _cCard & ";border-radius:8px;padding:24px;color:" & _cText & ";font-size:14pt;'>Sem dados para os filtros atuais</div>",
			        "<div style='font-family:Segoe UI,Segoe,sans-serif;background:" & _cCard & ";border-radius:8px;padding:24px;color:" & _cText & ";font-size:14pt;line-height:1.5;'>" &
			        "<div style='color:" & _cSec & ";font-size:12pt;margin-bottom:8px;'>Resumo executivo · " & _periodo & "</div>" &
			        _insight &
			        _h & "CONTEXTO</div>" & _ctx1 & _ctx2 & _ctx3 &
			        _atencao &
			        _passos &
			        "</div>" )
		displayFolder: 4. HTML
		lineageTag: 66246ee6-9373-480b-8c5d-0e355af628e2

	/// Versão curta da narrativa para a diretoria (visual HTML Content): só o cabeçalho com período e o insight principal em uma frase — receita, atingimento da meta com gap/folga e variação frente ao mesmo período do ano anterior. Sem contexto, pontos de atenção ou próximos passos (ver HTML Narrativa Visão Geral). Tokens do DESING.md; partes somem quando falta base.
	measure 'HTML Insight Visão Geral' =
			-- Tokens (DESING.md)
			VAR _cCard = "#11162D"
			VAR _cText = "#F5F7FF"
			VAR _cSec  = "#BFC8E2"
			VAR _cFav  = "#50D6B2"
			VAR _cDes  = "#FF7D92"
			
			-- Formatos
			VAR _fBRL = "R$ #,##0"
			VAR _fPct = "0.0%"
			VAR _fVar = "+0.0%;-0.0%;0.0%"
			
			-- KPIs do contexto
			VAR _rec    = [Receita]
			VAR _varRec = [Receita Var. Anual %]
			VAR _meta   = [Meta]
			VAR _ating  = [Atingimento %]
			VAR _gap    = [Gap Meta]
			VAR _d1 = CALCULATE( MIN( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _d2 = CALCULATE( MAX( fato_vendas[Data] ), fato_vendas[Status] = "Faturado" )
			VAR _periodo = FORMAT( _d1, "dd/MM/yyyy" ) & " a " & FORMAT( _d2, "dd/MM/yyyy" )
			
			-- Insight principal
			VAR _corAting = SWITCH( TRUE(), ISBLANK( _ating ), _cSec, _ating >= 1, _cFav, _cDes )
			VAR _fraseMeta =
			    IF( ISBLANK( _meta ), "sem meta definida para o período",
			        "<span style='color:" & _corAting & ";font-weight:600;'>" & FORMAT( _ating, _fPct, "pt-BR" ) & " da meta</span> de " & FORMAT( _meta, _fBRL, "pt-BR" ) &
			        " (" & IF( _gap >= 0, "folga", "gap" ) & " de " & FORMAT( ABS( _gap ), _fBRL, "pt-BR" ) & ")" )
			VAR _fraseVar =
			    IF( ISBLANK( _varRec ), "",
			        " e <span style='color:" & IF( _varRec >= 0, _cFav, _cDes ) & ";font-weight:600;'>" & FORMAT( _varRec, _fVar, "pt-BR" ) & "</span> frente ao mesmo período do ano anterior" )
			
			RETURN
			    IF( ISBLANK( _rec ),
			        "<div style='font-family:Segoe UI,Segoe,sans-serif;background:" & _cCard & ";border-radius:8px;padding:24px;color:" & _cText & ";font-size:14pt;'>Sem dados para os filtros atuais</div>",
			        "<div style='font-family:Segoe UI,Segoe,sans-serif;background:" & _cCard & ";border-radius:8px;padding:24px;color:" & _cText & ";'>" &
			        "<div style='color:" & _cSec & ";font-size:12pt;margin-bottom:8px;'>Resumo executivo · " & _periodo & "</div>" &
			        "<div style='color:" & _cText & ";font-size:20pt;font-weight:600;line-height:1.3;'>" &
			        "Receita de " & FORMAT( _rec, _fBRL, "pt-BR" ) & ", " & _fraseMeta & _fraseVar & "." &
			        "</div></div>" )
		displayFolder: 4. HTML
		lineageTag: 04ee43e1-8b62-466a-8d42-a62112e68e0d

	column 'Coluna 1'
		dataType: string
		isHidden
		displayFolder: 0. Aux
		lineageTag: 19e8eccc-c0b9-4766-a2c5-18275edf870f
		summarizeBy: none
		sourceColumn: Coluna 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		queryGroup: Aux
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação


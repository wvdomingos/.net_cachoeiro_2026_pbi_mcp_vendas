		summarizeBy: none
		sourceColumn: Regiao

		annotation SummarizationSetBy = Automatic

	partition dim_clientes = m
		mode: import
		queryGroup: Dimensão
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(pCaminhoExcel), null, true),
				    Planilha = Fonte{[Item="dim_clientes",Kind="Sheet"]}[Data],
				    CabecalhoPromovido = Table.PromoteHeaders(Planilha, [PromoteAllScalars=true]),
				    TipoAlterado = Table.TransformColumnTypes(CabecalhoPromovido,{{"ClienteID", type text}, {"Cliente", type text}, {"Segmento", type text}, {"UF", type text}, {"Regiao", type text}})
				in
				    TipoAlterado

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

